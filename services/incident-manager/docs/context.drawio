<mxfile host="app.diagrams.net">
  <diagram name="Context Diagram" id="incident-context-v1">
    <mxGraphModel dx="1200" dy="750" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="827" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Заголовок -->
        <mxCell id="title" parent="1" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=18;fontStyle=1;fontColor=#1a1a1a;" value="Context Diagram: Incident Manager (Team 5)" vertex="1">
          <mxGeometry x="40" y="25" width="480" height="30" as="geometry" />
        </mxCell>

        <!-- Користувач (Actor) -->
        <mxCell id="user-actor" parent="1" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#f5f5f5;strokeColor=#666666;fontStyle=1;fontSize=12;" value="Network Operator&#xa;(Console User)" vertex="1">
          <mxGeometry x="70" y="215" width="45" height="90" as="geometry" />
        </mxCell>

        <!-- Головний сервіс по центру -->
        <mxCell id="main-system" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;strokeWidth=2;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" value="&lt;&lt;Console Application&gt;&gt;&#xa;&#xa;Incident Manager&#xa;(Team 5)&#xa;&#xa;services/incident-manager" vertex="1">
          <mxGeometry x="410" y="185" width="230" height="150" as="geometry" />
        </mxCell>

        <!-- Стрілка 1: Користувач -> Сервіс -->
        <mxCell id="arrow-in" edge="1" parent="1" source="user-actor" target="main-system" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.3;exitDx=0;exitDy=0;exitPerimeter=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="242" />
              <mxPoint x="260" y="223" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-in" connectable="0" parent="arrow-in" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" value="menu option, targetId,&#xa;incident data (id, source, category, severity)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-24" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Стрілка 2: Сервіс -> Користувач -->
        <mxCell id="arrow-out" edge="1" parent="1" source="main-system" target="user-actor" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;entryPerimeter=0;endArrow=block;endFill=1;strokeWidth=2;strokeColor=#333333;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="260" y="298" />
              <mxPoint x="260" y="278" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-out" connectable="0" parent="arrow-out" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;fontStyle=1;labelBackgroundColor=#ffffff;" value="open incidents list, escalation alerts,&#xa;validation &amp; status messages" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="25" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Майбутні сервіси (Пунктир) -->
        <!-- Сервіс 4 -->
        <mxCell id="srv-4" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;dashed=1;dashPattern=6 4;strokeWidth=1.5;fontSize=12;fontStyle=1;" value="&lt;&lt;Future Service 4&gt;&gt;&#xa;Event Queue&#xa;(services/event-queue)" vertex="1">
          <mxGeometry x="880" y="75" width="210" height="75" as="geometry" />
        </mxCell>
        <mxCell id="arrow-srv4" edge="1" parent="1" source="srv-4" target="main-system" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="113" />
              <mxPoint x="760" y="215" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-srv4" connectable="0" parent="arrow-srv4" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" value="network events&#xa;(future input)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="-20" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Сервіс 7 -->
        <mxCell id="srv-7" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;dashed=1;dashPattern=6 4;strokeWidth=1.5;fontSize=12;fontStyle=1;" value="&lt;&lt;Future Service 7&gt;&gt;&#xa;Recovery Simulator&#xa;(services/recovery-simulator)" vertex="1">
          <mxGeometry x="880" y="222" width="210" height="75" as="geometry" />
        </mxCell>
        <mxCell id="arrow-srv7" edge="1" parent="1" source="main-system" target="srv-7" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="label-srv7" connectable="0" parent="arrow-srv7" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" value="CRITICAL incidents&#xa;(future output)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="-18" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Сервіс 8 -->
        <mxCell id="srv-8" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;dashed=1;dashPattern=6 4;strokeWidth=1.5;fontSize=12;fontStyle=1;" value="&lt;&lt;Future Service 8&gt;&gt;&#xa;Operations Report&#xa;(services/operations-report)" vertex="1">
          <mxGeometry x="880" y="370" width="210" height="75" as="geometry" />
        </mxCell>
        <mxCell id="arrow-srv8" edge="1" parent="1" source="main-system" target="srv-8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;exitX=1;exitY=0.8;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;endArrow=open;endFill=0;strokeWidth=1.5;strokeColor=#666666;">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="760" y="305" />
              <mxPoint x="760" y="408" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="label-srv8" connectable="0" parent="arrow-srv8" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=11;labelBackgroundColor=#ffffff;" value="critical records &amp; status&#xa;(future output)" vertex="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="15" y="22" as="offset" />
          </mxGeometry>
        </mxCell>

        <!-- Легенда внизу -->
        <mxCell id="legend" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#f8f9fa;strokeColor=#666666;fontColor=#222222;align=left;verticalAlign=top;spacingLeft=12;spacingTop=8;spacingRight=12;fontSize=11;size=14;" value="Позначення: суцільні лінії — поточна консольна взаємодія у версії v1.0.0; пунктирні лінії — запланована інтеграція із сусідніми сервісами (у поточній версії не реалізується)." vertex="1">
          <mxGeometry x="40" y="470" width="1050" height="50" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
